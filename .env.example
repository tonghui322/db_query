# ====================== MySQL 连接 ======================
# 把你自己的数据库连接信息填到这里，然后另存为 .env

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的密码
DB_NAME=你的库名

# 建议专门建只读账号（见 README 的安全部分），防止模型生成危险 SQL
# DB_USER=nl2sql_read
# DB_PASSWORD=只读账号密码

# 用到的表名，逗号分隔；留空表示全部表
# DB_TABLES=orders,customers,products

# 表名前缀黑名单，逗号分隔（屏蔽框架表，如 Quartz 定时任务、RuoYi 系统表）
# DB_TABLE_BLACKLIST=qrtz_,sys_

# ====================== Embedding 配置（Schema 检索） ======================
# 默认千问 DashScope。Schema 检索依赖此 Key，配置后运行：
#   python -m schema_build.seed_vector
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_API_KEY=你的千问DashScopeAPIKey
EMBED_MODEL=text-embedding-v3

# Schema 检索参数
SCHEMA_TOP_K=8              # 每次喂给模型的相关表数量
VECTOR_STORE_PATH=schema_build/table_vectors.npz

# ====================== LLM 配置 ======================
# 默认 DeepSeek。换其他模型改 base_url 和 model 即可
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=你的DeepSeekAPIKey
LLM_MODEL=deepseek-chat

# 示例：OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# 示例：本地 Ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:14b

# ====================== API 服务鉴权（可选） ======================
# 配置后，调用 /query 需在请求头带上 X-API-Key: <值>；留空则不开鉴权
# API_KEY=

# ====================== 运行参数 ======================
LLM_TEMPERATURE=0
MAX_SQL_RETRY=3        # 报错后重写 SQL 的最大重试次数
SQL_TIMEOUT_MS=10000   # SQL 执行超时(毫秒)
RESULT_LIMIT=1000      # 强制结果行数上限
